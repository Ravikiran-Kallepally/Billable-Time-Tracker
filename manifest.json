{
  "manifest_version": 3,
  "name": "Billable Time Tracker",
  "version": "0.1.0",
  "description": "Passively tracks browser time per domain, tags it to clients, and generates invoices. Local-only prototype.",
  "permissions": ["tabs", "idle", "storage", "alarms", "downloads"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Billable Time Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
